<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:macro name="denso_robot_control_limits" params="namespace initial_positions_file">
		
	  <joint name="${namespace}joint_1">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position">
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort"/>
    </joint>
    <joint name="${namespace}joint_2">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position">
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort"/>
    </joint>
    <joint name="${namespace}joint_3">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position">
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort"/>
    </joint>
    <joint name="${namespace}joint_4">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position">
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort"/>
    </joint>
    <joint name="${namespace}joint_5">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position">
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort"/>
    </joint>
    <joint name="${namespace}joint_6">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position">
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort"/>
    </joint>
	</xacro:macro>
</robot>