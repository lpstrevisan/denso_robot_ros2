<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
     
    <xacro:macro name="tool" params="namespace">

    <link name="$(arg namespace)basic_camera_link">
		<inertial>
			<mass value="1"/>
			<inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
		</inertial>
		<collision>
			<geometry>
				<box size="0.01 0.01 0.01"/> 
			</geometry>
		</collision>
		<visual>
			<geometry>
				<box size="0.01 0.01 0.01"/> 
			</geometry>
		</visual>
	</link>

	<joint name="$(arg namespace)basic_camera_joint" type="fixed">
		<parent link="$(arg namespace)J6"/> 
		<child link="$(arg namespace)basic_camera_link"/>
		<origin rpy="0 ${radians(-90)} 0" xyz="0 0 0.01"/>
	</joint>

    <gazebo reference="$(arg namespace)basic_camera_link">
      <sensor name="basic_camera" type="camera">
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>basic_camera</topic>      
      </sensor>
    </gazebo>
    </xacro:macro>
</robot>